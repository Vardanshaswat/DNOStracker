# Random secret used to sign session cookies (required in production)
# openssl rand -base64 32
JWT_SECRET=

# Local Vite origins. Leave unset in production when the UI is served from the same URL as the API.
CLIENT_ORIGINS=http://127.0.0.1:4179,http://localhost:4179

# Optional. Production Docker/Railway volume should be /data
# DATA_DIR=/data
